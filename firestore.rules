rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    

    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Users collection
    match /users/{userId} {
      // Users can read their own data, admins can read all
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      // Users can manage their own profile (needed for initialization), Admins can manage all
      allow write: if isAuthenticated() && (isOwner(userId) || isAdmin());
    }
    
    // Queries collection
    match /queries/{queryId} {
      // Anyone authenticated can create queries
      allow create: if isAuthenticated();
      // Users can read their own queries, admins can read all
      allow read: if isAuthenticated() && (resource.data.clientId == request.auth.uid || isAdmin());
      // Only admins can update queries
      allow update: if isAdmin();
      // Admins can delete any query, clients can delete their own queries
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.clientId == request.auth.uid);
    }
    
    // Invoices collection
    match /invoices/{invoiceId} {
      // Only admins can create invoices
      allow create: if isAdmin();
      // Users can read their own invoices, admins can read all
      allow read: if isAuthenticated() && (resource.data.clientId == request.auth.uid || isAdmin());
      // Only admins can update invoices
      allow update: if isAdmin();
      // Only admins can delete invoices
      allow delete: if isAdmin();
    }
  }
}
